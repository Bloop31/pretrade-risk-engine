# Copy to .env for local development.

# --- Redis ---------------------------------------------------------------
# Plain:  redis://localhost:6379/0
# TLS:    rediss://risk-service@redis.internal:6380/0?ssl_cert_reqs=required&ssl_ca_certs=/etc/ssl/redis-ca.pem
REDIS_URL=redis://localhost:6379/0
# Password for the Redis user, kept out of the URL. A password in REDIS_URL wins.
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT_SECONDS=0.25

# --- Auth ----------------------------------------------------------------
# Client keys for /v1/*, sent as X-API-Key. Comma-separated to rotate keys.
# Each at least 16 characters. Required unless API_AUTH_DISABLED=true.
API_KEYS=
# Local development only: accept /v1/* calls without a key.
API_AUTH_DISABLED=true
# Enables /admin/* (X-Admin-Key). Leave empty to disable the admin API.
ADMIN_API_KEY=

# --- Rules ---------------------------------------------------------------
RULES_PATH=config/rules.yaml
RULES_WATCH_ENABLED=true
RULES_RELOAD_INTERVAL_SECONDS=1.0

# --- Logging -------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true
HEALTH_CHECK_TIMEOUT_SECONDS=0.5
