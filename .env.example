# Copy to .env for local development. Every value here has a default in settings.py.
REDIS_URL=redis://localhost:6379/0
RULES_PATH=config/rules.yaml
RULES_RELOAD_INTERVAL_SECONDS=2.0
LOG_LEVEL=INFO
LOG_JSON=true
HEALTH_CHECK_TIMEOUT_SECONDS=0.5
# Required to call /admin/* endpoints. Leave unset to disable them.
ADMIN_API_KEY=
